bound=false}}}const ne="4";if(typeof window!=="undefined")(window.__svelte||(window.__svelte={v:new Set})).v.add(ne);let oe="https://adrenalead.com/policy/politique-de-confidentialite-editeur/";let ae="https://adrenalead.com/en/adrenalead-privacy-policy-publishers/";let re="https://adrenalead.com/politiques-de-confidentialites/politique-de-confidentialite-annonceur/";let le="https://adrenalead.com/en/adrenalead-privacy-policy-advertisers/";let se=window.nadzEMercant?re:oe;let g=window.nadzEMercant?le:ae;const ce={fr:{desktopBanner:"Restons en contact !",desktopInstructions:"Cliquez sur la cloche pour recevoir nos nouveautés",desktopDisclaimer:"Autorisez les notifications pour recevoir les actualités du site et du contenu sponsorisé. En autorisant les notifications, vous acceptez notre {{policy}}.",mobileDisclaimer:"*En autorisant les notifications de ce site, vous acceptez de recevoir des notifications contenant du contenu sponsorisé par nos partenaires publicitaires. Pour vous désabonner, rendez-vous dans les préférences de votre navigateur web et désactivez les notifications pour ce site. Pour en savoir plus sur le traitement de vos données, consultez notre {{policy}}.",privacyPolicyLabel:"Politique de Confidentialité",privacyPolicyUrl:se,mobTitleDefault:"Activez les notifications et ne ratez plus aucune actu.",mobInstruction:"Pour autoriser, cliquez sur {allow} en haut de l’écran",mobAllowLabel:"« Autoriser »",mobHint:"Le bandeau a disparu ? Touchez l’icône à gauche de l’adresse pour autoriser les notifications.",mobClose:"Fermer"},es:{desktopBanner:"¡Sigamos en contacto!",desktopInstructions:"Oprima la campana para recibir nuestras notificaciones",desktopDisclaimer:"Al permitir notificaciones recibirá novedades del sitio web y contenido patrocinado. Al aceptar notificaciones usted acepta nuestra {{policy}}.",mobileDisclaimer:"*Al activar las notificaciones de este sitio, usted acepta recibir notificaciones con contenido patrocinado de nuestros socios publicitarios. Para darse de baja, vaya a las preferencias de su navegador y desactive las notificaciones de este sitio. Para más información sobre cómo tratamos sus datos, consulte nuestra {{policy}}.",privacyPolicyLabel:"Política de Privacidad",privacyPolicyUrl:g,mobTitleDefault:"Activa las notificaciones y no te pierdas ninguna novedad.",mobInstruction:"Para autorizar, haz clic en {allow} en la parte superior de la pantalla",mobAllowLabel:"«Permitir»",mobHint:"¿Ha desaparecido el banner? Toca el icono a la izquierda de la dirección para autorizar las notificaciones.",mobClose:"Cerrar"},it:{desktopBanner:"Teniamoci in contatto!",desktopInstructions:"Clicca sull'icona a forma di campana per ricevere le nostre notifiche",desktopDisclaimer:"Consentire le notifiche per ricevere le notizie del sito e i contenuti pubblicitari. Consentendo le notifiche, l'utente accetta la nostra {{policy}}.",mobileDisclaimer:"*Abilitando le notifiche di questo sito, accetti di ricevere notifiche contenenti contenuti sponsorizzati dai nostri partner pubblicitari. Per annullare l'iscrizione, vai alle preferenze del tuo browser e disattiva le notifiche per questo sito. Per maggiori informazioni su come trattiamo i tuoi dati, consulta la nostra {{policy}}.",privacyPolicyLabel:"Privacy Policy",privacyPolicyUrl:g,mobTitleDefault:"Attiva le notifiche e non perdere più nessuna novità.",mobInstruction:"Per autorizzare, clicca su {allow} in alto sullo schermo",mobAllowLabel:"«Consenti»",mobHint:"Il banner è scomparso? Tocca l’icona a sinistra dell’indirizzo per consentire le notifiche.",mobClose:"Chiudi"},de:{desktopBanner:"Lassen Sie uns in Kontakt bleiben!",desktopInstructions:"Klicken Sie auf das Glockensymbol, um unsere Benachrichtigungen zu erhalten",desktopDisclaimer:"Lassen Sie Benachrichtigungen zu, um Neuigkeiten auf der Website und gesponserte Inhalte zu erhalten. Wenn Sie Benachrichtigungen zulassen, akzeptieren Sie unsere {{policy}}.",mobileDisclaimer:"*Indem Sie Benachrichtigungen für diese Website zulassen, erklären Sie sich damit einverstanden, Benachrichtigungen mit gesponserten Inhalten von unseren Werbepartnern zu erhalten. Um sich abzumelden, gehen Sie zu den Einstellungen Ihres Webbrowsers und deaktivieren Sie die Benachrichtigungen für diese Website. Weitere Informationen über den Umgang mit Ihren Daten finden Sie in unserer {{policy}}.",privacyPolicyLabel:"Datenschutzrichtlinie",privacyPolicyUrl:g,mobTitleDefault:"Aktivieren Sie die Benachrichtigungen und verpassen Sie keine Neuigkeit mehr.",mobInstruction:"Zum Erlauben tippen Sie oben auf dem Bildschirm auf {allow}",mobAllowLabel:"„Zulassen“",mobHint:"Banner verschwunden? Tippen Sie auf das Symbol links neben der Adresse, um Benachrichtigungen zu erlauben.",mobClose:"Schließen"},pt:{desktopBanner:"Vamos manter-nos em contacto!",desktopInstructions:"Clique na campainha para receber as nossas notificações",desktopDisclaimer:"Ao permitir notificações, receberá notícias do sítio e conteúdos patrocinados. Ao aceitar notificações, está a concordar com a nossa {{policy}}.",mobileDisclaimer:"*Ao habilitar notificações deste site, você concorda em receber notificações contendo conteúdo patrocinado de nossos parceiros publicitários. Para cancelar a inscrição, vá para as preferências de seu navegador da web e desligue as notificações para este site. Para mais informações sobre como lidamos com seus dados, consulte nossa {{policy}}.",privacyPolicyLabel:"Política de Privacidade",privacyPolicyUrl:g,mobTitleDefault:"Ative as notificações e não perca nenhuma novidade.",mobInstruction:"Para autorizar, clique em {allow} na parte superior da tela",mobAllowLabel:"“Permitir”",mobHint:"O banner desapareceu? Toque no ícone à esquerda do endereço para permitir as notificações.",mobClose:"Fechar"},pl:{desktopBanner:"Zostańmy w kontakcie!",desktopInstructions:"Kliknij ikonę dzwonka, aby otrzymać nasze powiadomienia",desktopDisclaimer:"Zezwalaj na powiadomienia o nowościach w witrynie i sponsorowanych treściach. Zezwalając na powiadomienia, akceptujesz naszą {{policy}}.",mobileDisclaimer:"*Zezwalając na powiadomienia dla tej witryny, wyrażasz zgodę na otrzymywanie powiadomień zawierających treści sponsorowane przez naszych partnerów reklamowych. Aby zrezygnować z subskrypcji, należy przejść do preferencji przeglądarki internetowej i wyłączyć powiadomienia dla tej witryny. Aby uzyskać więcej informacji na temat przetwarzania danych osobowych, zapoznaj się z naszą {{policy}}.",privacyPolicyLabel:"Politykę Prywatności",privacyPolicyUrl:g,mobTitleDefault:"Włącz powiadomienia i nie przegap żadnych nowości.",mobInstruction:"Aby zezwolić, kliknij {allow} u góry ekranu",mobAllowLabel:"„Zezwól”",mobHint:"Baner zniknął? Dotknij ikony po lewej stronie adresu, aby zezwolić na powiadomienia.",mobClose:"Zamknij"},cz:{desktopBanner:"Zůstaňme v kontaktu!",desktopInstructions:"Není vyžadován žádný e-mail. Kliknutím na ikonu zvonku obdržíte naše upozornění",desktopDisclaimer:"Povolit upozornění pro příjem novinek z webu a sponzorovaného obsahu. Povolením upozornění přijímáte naše {{policy}}.",mobileDisclaimer:"*Povolením oznámení pro tento web souhlasíte se zasíláním oznámení obsahujících sponzorovaný obsah od našich reklamních partnerů. Chcete-li se odhlásit, přejděte do nastavení webového prohlížeče a vypněte zasílání oznámení pro tento web. Další informace o tom, jak nakládáme s vašimi údaji, naleznete v našich  {{policy}}.",privacyPolicyLabel:"Zásady ochrany osobních údajů",privacyPolicyUrl:g,mobTitleDefault:"Zapněte si oznámení a nenechte si ujít žádnou novinku.",mobInstruction:"Pro povolení klepněte na {allow} v horní části obrazovky",mobAllowLabel:"„Povolit“",mobHint:"Banner zmizel? Klepněte na ikonu vlevo od adresy a povolte oznámení.",mobClose:"Zavřít"},en:{desktopBanner:"Let's stay in touch!",desktopInstructions:"Click the icon bell to stay updated with our notifications",desktopDisclaimer:"Allow notifications to receive website news and sponsored content. By allowing notifications you accept our {{policy}}.",mobileDisclaimer:"*By allowing notifications for this site, you agree to receive notifications containing sponsored content from our advertising partners. To unsubscribe, go to your web browser preferences and turn off notifications for this site. For more information on how we handle your data, please see our {{policy}}.",privacyPolicyLabel:"Privacy Policy",privacyPolicyUrl:g,mobTitleDefault:"Turn on notifications and never miss any news.",mobInstruction:"To allow, click {allow} at the top of the screen",mobAllowLabel:"“Allow”",mobHint:"Banner gone? Tap the icon to the left of the address to allow notifications.",mobClose:"Close"},ja:{desktopBanner:"最新情報をお届けします！",desktopInstructions:"ベルのアイコンをクリックして、通知を受け取りましょう",desktopDisclaimer:"通知を許可いただくと、当ウェブサイトの新着情報やスポンサーコンテンツを受け取ることができます。通知を許可することで、{{policy}}に同意したものとみなされます。",mobileDisclaimer:"※通知を許可することで、新着情報や広告パートナーからのスポンサーコンテンツを含む通知を受け取ることに同意したものとみなされます。通知の停止は、ウェブブラウザの設定からいつでも行えます。データの取り扱いについては、{{policy}}をご覧ください。",privacyPolicyLabel:"プライバシーポリシー",privacyPolicyUrl:g,mobTitleDefault:"通知をオンにして、最新ニュースを見逃さないようにしましょう。",mobInstruction:"許可するには、画面上部の{allow}をタップしてください",mobAllowLabel:"「許可」",mobHint:"バナーが消えましたか？アドレスの左にあるアイコンをタップして、通知を許可してください。",mobClose:"閉じる"},ro:{desktopBanner:"Să rămânem în contact!",desktopInstructions:"Click pe pictograma clopoțel pentru a rămâne la curent cu notificările noastre",desktopDisclaimer:"Permite notificările pentru a primi știri de pe site și conținut sponsorizat. Permițând notificările, accepți {{policy}}.",mobileDisclaimer:"*Permițând notificările pentru acest site, ești de acord să primești notificări care conțin conținut sponsorizat de partenerii noștri publicitari. Pentru a te dezabona, mergi la preferințele browserului tău web și dezactivează notificările pentru acest site. Pentru mai multe informații despre modul în care gestionăm datele tale, te rugăm să consulți {{policy}}.",privacyPolicyLabel:"Politica de Confidențialitate",privacyPolicyUrl:g,mobTitleDefault:"Activează notificările și nu mai rata nicio noutate.",mobInstruction:"Pentru a permite, apasă pe {allow} în partea de sus a ecranului",mobAllowLabel:"„Permite”",mobHint:"Bannerul a dispărut? Atinge pictograma din stânga adresei pentru a permite notificările.",mobClose:"Închide"},el:{desktopBanner:"Ας μείνουμε σε επαφή!",desktopInstructions:"Κάντε κλικ στο εικονίδιο καμπάνας για να ενημερώνεστε με τις ειδοποιήσεις μας",desktopDisclaimer:"Επιτρέψτε ειδοποιήσεις για να λαμβάνετε νέα του ιστότοπου και χορηγούμενο περιεχόμενο. Με την αποδοχή ειδοποιήσεων αποδέχεστε την {{policy}}.",mobileDisclaimer:"*Με την αποδοχή ειδοποιήσεων για αυτόν τον ιστότοπο, συμφωνείτε να λαμβάνετε ειδοποιήσεις που περιέχουν χορηγούμενο περιεχόμενο από τους διαφημιστικούς συνεργάτες μας. Για να διαγραφείτε, μεταβείτε στις προτιμήσεις του προγράμματος περιήγησης ιστού σας και απενεργοποιήστε τις ειδοποιήσεις για αυτόν τον ιστότοπο. Για περισσότερες πληροφορίες σχετικά με τον τρόπο διαχείρισης των δεδομένων σας, παρακαλούμε δείτε την {{policy}}.",privacyPolicyLabel:"Πολιτική Απορρήτου",privacyPolicyUrl:g,mobTitleDefault:"Ενεργοποιήστε τις ειδοποιήσεις και μη χάνετε καμία είδηση.",mobInstruction:"Για να επιτρέψετε, πατήστε {allow} στο πάνω μέρος της οθόνης",mobAllowLabel:"«Να επιτρέπεται»",mobHint:"Το banner εξαφανίστηκε; Πατήστε το εικονίδιο στα αριστερά της διεύθυνσης για να επιτρέψετε τις ειδοποιήσεις.",mobClose:"Κλείσιμο"},nl:{desktopBanner:"Laten we in contact blijven!",desktopInstructions:"Klik op het belpictogram om op de hoogte te blijven van onze meldingen",desktopDisclaimer:"Sta meldingen toe om nieuws van de website en gesponsorde inhoud te ontvangen. Door meldingen toe te staan, ga je akkoord met onze {{policy}}.",mobileDisclaimer:"*Door meldingen voor deze site toe te staan, ga je ermee akkoord meldingen te ontvangen die gesponsorde inhoud bevatten van onze advertentiepartners. Om je af te melden, ga naar de voorkeuren van je webbrowser en schakel meldingen voor deze site uit. Voor meer informatie over hoe we je gegevens verwerken, raadpleeg onze {{policy}}.",privacyPolicyLabel:"Privacybeleid",privacyPolicyUrl:g,mobTitleDefault:"Zet meldingen aan en mis geen enkel nieuwtje meer.",mobInstruction:"Klik bovenaan het scherm op {allow} om toe te staan",mobAllowLabel:"“Toestaan”",mobHint:"Is de banner verdwenen? Tik op het pictogram links van het adres om meldingen toe te staan.",mobClose:"Sluiten"},lt:{desktopBanner:"Palaikykime ryšį!",desktopInstructions:"Spustelėkite varpelio piktogramą, kad liktumėte informuoti apie mūsų pranešimus",desktopDisclaimer:"Leiskite pranešimus, kad gautumėte svetainės naujienas ir sponsoruojamą turinį. Leidžiant pranešimus, jūs sutinkate su mūsų {{policy}}.",mobileDisclaimer:"*Leisdami pranešimus šiai svetainei, sutinkate gauti pranešimus su sponsoruojamu turiniu iš mūsų reklamos partnerių. Norėdami atsisakyti, eikite į savo interneto naršyklės nustatymus ir išjunkite pranešimus šiai svetainei. Daugiau informacijos apie tai, kaip tvarkome jūsų duomenis, rasite mūsų {{policy}}.",privacyPolicyLabel:"Privatumo politika",privacyPolicyUrl:g,mobTitleDefault:"Įjunkite pranešimus ir nepraleiskite jokių naujienų.",mobInstruction:"Norėdami leisti, spustelėkite {allow} ekrano viršuje",mobAllowLabel:"„Leisti“",mobHint:"Reklamjuostė dingo? Palieskite piktogramą kairėje adreso pusėje, kad leistumėte pranešimus.",mobClose:"Uždaryti"}};function de(e){let i;let n;let o;let a;let r;let l;let s;let c;let d;let p;let u;let f;return{c(){i=b("svg");n=b("defs");o=b("style");a=Z(".pushmaster_cls-1 {\n        fill: #e6e6e6;\n      }\n      .pushmaster_cls-2 {\n        fill: #adadd8;\n      }\n      .pushmaster_cls-3 {\n        fill: #ccc;\n      }\n    ");r=b("g");l=b("g");s=b("path");c=b("path");d=b("path");p=b("path");u=b("path");f=b("path");N(s,"class","pushmaster_cls-1");N(s,"d","M333.25,0H0V51H333.25a25.5,25.5,0,0,0,0-51Z");N(c,"class","pushmaster_cls-2");N(c,"d","M298.27,13.18a2.39,2.39,0,0,1-.27.43q-3.08,3.09-6.17,6.16L273.1,38.48l-.16.15a.53.53,0,0,1-.